# HyperStack bench kit - every variable the compose file and the seed scripts read.
#
# Copy this file to .env (`cp .env.example .env`) and set every `change-me`
# to a password of your own before the first `up`. .env is gitignored; the
# owner's filled-in .env is handed over separately, never committed.
# Usernames, ports and database names below are the bench defaults that
# HyperStack's saved profiles expect.
#
# Format: KEY=value, one per line, no spaces around "=". Quote a value that
# contains "#" or spaces with single quotes. Compose and seed/lib.sh both read
# this file, and nothing in the kit hard-codes a password.
#
# Keep passwords to letters, digits and - _ . (plus the symbol SQL Server
# needs): several land in JSON, JAAS, SCRAM and sqlplus strings unescaped.

# Compose project name: containers are hs-bench-<service>-1, volumes hs-bench_<name>.
COMPOSE_PROJECT_NAME=hs-bench

# The address HyperStack (and any other client) uses to reach this machine.
# Kafka advertises it to clients and Forgejo builds its links from it: set it
# to the Linux box's LAN IP or DNS name when HyperStack runs on another machine.
BENCH_HOST=127.0.0.1

# ---- host ports -------------------------------------------------------------
# Every port the kit publishes on this machine. The compose file and the seeds
# both read these, so a port that is already taken here is changed in this one
# place. Keep the defaults to match the Windows/WSL bench and HyperStack's
# saved profiles. Kafka (both brokers) and MinIO listen on the host port inside
# their containers too, so the address they hand to clients works everywhere.
PG_PORT=5432
MYSQL_PORT=3307
MONGO_PORT=27017
REDIS_PORT=6381
VALKEY_PORT=6380
COUCH_PORT=5984
S3_PORT=9000
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
SSH_PORT=2222
WEBDAV_PORT=8086
HTTPBIN_PORT=8088
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Not 9093 or 9095: the brokers' controllers use those inside their containers.
KAFKA_PORT=9092
KAFKA_SASL_PORT=9094
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MQTT_PORT=1883
FORGEJO_PORT=3000
JENKINS_PORT=8091
TEAMCITY_PORT=8111
REDMINE_PORT=3010
PUPPETDB_PORT=8082
MSSQL_PORT=1433
ORACLE_PORT=1521
DB2_PORT=50000
CLICKHOUSE_PORT=8123
NEXUS_PORT=8081
K3S_PORT=6443
K3S_HTTP_PORT=8080
KEYCLOAK_PORT=8180

# ---- core -------------------------------------------------------------------
# PostgreSQL (5432). The seed also creates the Windows bench's other two
# logins, PG_APP_USER and `postgres` (both superusers), with the passwords below.
POSTGRES_USER=dev
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop
PG_APP_USER=app
PG_APP_PASSWORD=change-me
PG_SUPERUSER_PASSWORD=change-me

# MySQL (3307 on the host, as on the Windows bench)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=dev
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=shop

# MongoDB (27017). Auth is OFF (as on the Windows bench); the seed still
# creates this root user in `admin`, so a profile with or without it works.
MONGO_USER=dev
MONGO_PASSWORD=change-me

# CouchDB (5984). The seed adds a second admin dev/COUCH_DEV_PASSWORD.
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
COUCH_DEV_PASSWORD=change-me

# S3 (MinIO, API 9000, console 9001). Real keys, unlike the Windows bench's
# s3mock, which accepts any key at all. MinIO wants a secret of 8+ characters.
S3_ACCESS_KEY=dev
S3_SECRET_KEY=change-me
S3_REGION=us-east-1

# OpenSSH (2222)
SSH_USER=dev
SSH_PASSWORD=change-me

# WebDAV (8086), served at the root path "/"
WEBDAV_USER=dev
WEBDAV_PASSWORD=change-me

# Redis (6381), Valkey (6380), Qdrant (6333/6334), httpbin (8088): no auth.

# ---- queue ------------------------------------------------------------------
# RabbitMQ (AMQP 5672, management 15672)
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=change-me

# Kafka SASL (9094): PLAIN for both users, SCRAM-SHA-256/512 for the dev user.
# Kafka plain (9092), NATS (4222/8222), MQTT (1883): no auth.
KAFKA_SASL_ADMIN_USER=admin
KAFKA_SASL_ADMIN_PASSWORD=change-me
KAFKA_SASL_USER=dev
KAFKA_SASL_PASSWORD=change-me

# ---- ci ---------------------------------------------------------------------
# Forgejo (3000)
FORGEJO_ADMIN_USER=dev
FORGEJO_ADMIN_PASSWORD=change-me
FORGEJO_ADMIN_EMAIL=dev@example.test

# Jenkins (8091). The API token is generated on first start; the seed prints it.
JENKINS_USER=dev
JENKINS_PASSWORD=change-me

# TeamCity (8111). Created by hand in the first-start wizard (see README).
TEAMCITY_ADMIN_USER=admin
TEAMCITY_ADMIN_PASSWORD=change-me

# Redmine (3010). The seed sets this admin password; it prints the API key.
REDMINE_ADMIN_PASSWORD=change-me

# PuppetDB fake (8082): no auth.

# ---- idm --------------------------------------------------------------------
# Keycloak (8180, profile idm). The bootstrap admin of the master realm; the
# seed logs in as it to load realms hs-demo and hs-other.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password of every seeded demo user in hs-demo and hs-other.
KEYCLOAK_DEMO_PASSWORD=change-me
# Client secret of hs-demo's `hs-admin` service-account client, the one
# HyperStack's IDM activity connects with.
KEYCLOAK_HS_ADMIN_SECRET=change-me

# ---- k8s and heavy -------------------------------------------------------
# SQL Server (1433). Its policy: 8+ characters from three of upper, lower,
# digit and symbol - `change-me` itself is refused, so set a real one.
MSSQL_SA_PASSWORD=change-me

# Oracle Free (1521, service FREEPDB1). SYSTEM uses ORACLE_PASSWORD.
ORACLE_PASSWORD=change-me
ORACLE_APP_USER=app
ORACLE_APP_PASSWORD=change-me

# Db2 (50000, database TESTDB), instance user db2inst1
DB2INST1_PASSWORD=change-me
DB2_DBNAME=TESTDB

# ClickHouse (HTTP 8123)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me

# Nexus (8081). Starts as admin/admin123; the seed changes it to this.
NEXUS_ADMIN_PASSWORD=change-me

# k3s (6443, profile k8s): the cluster join token. seed-k8s.sh writes the
# kubeconfigs to .state/k3s/.
K3S_TOKEN=change-me
