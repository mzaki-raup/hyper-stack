{
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to the demo apps"
      },
      {
        "name": "editor",
        "description": "Can change content in the demo apps"
      },
      {
        "name": "admin",
        "description": "Administers the demo apps"
      },
      {
        "name": "power-user",
        "description": "Viewer and editor, with read and write on orders",
        "composite": true,
        "composites": {
          "realm": [
            "viewer",
            "editor"
          ],
          "client": {
            "orders-api": [
              "orders:read",
              "orders:write"
            ]
          }
        }
      }
    ],
    "client": {
      "orders-api": [
        {
          "name": "orders:read",
          "description": "Read orders"
        },
        {
          "name": "orders:write",
          "description": "Create and change orders"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "engineering",
      "attributes": {
        "costCentre": [
          "CC-100"
        ]
      },
      "realmRoles": [
        "viewer"
      ],
      "clientRoles": {
        "orders-api": [
          "orders:read"
        ]
      },
      "subGroups": [
        {
          "name": "backend",
          "attributes": {
            "costCentre": [
              "CC-110"
            ]
          },
          "clientRoles": {
            "orders-api": [
              "orders:write"
            ]
          },
          "path": "/engineering/backend"
        },
        {
          "name": "frontend",
          "attributes": {
            "costCentre": [
              "CC-120"
            ]
          },
          "path": "/engineering/frontend"
        }
      ],
      "path": "/engineering"
    },
    {
      "name": "support",
      "attributes": {
        "costCentre": [
          "CC-200"
        ]
      },
      "clientRoles": {
        "orders-api": [
          "orders:read"
        ]
      },
      "path": "/support"
    },
    {
      "name": "contractors",
      "attributes": {
        "costCentre": [
          "CC-900"
        ]
      },
      "path": "/contractors"
    }
  ],
  "clients": [
    {
      "clientId": "web-app",
      "name": "Web App",
      "description": "Public SPA client (standard flow and, for the bench, direct access grants)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "orders-api",
      "name": "Orders API",
      "description": "Confidential resource server with client roles",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "hs-admin",
      "name": "HyperStack Admin",
      "description": "Service account HyperStack's IDM activity connects with",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "@HS_ADMIN_SECRET@",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
