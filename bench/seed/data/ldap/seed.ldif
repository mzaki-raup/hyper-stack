# The bench directory (FEAT-0117): an OU tree, users and groups for the
# Identity activity's LDAP provider. Loaded by seed/seed-ldap.sh, which fills
# @BASE@ and @DEMO_PASSWORD@ from .env. groupOfNames nests a group by listing
# it as a member (engineering holds backend and frontend).

dn: ou=people,@BASE@
objectClass: organizationalUnit
ou: people
description: Everyone with an account

dn: ou=engineering,ou=people,@BASE@
objectClass: organizationalUnit
ou: engineering

dn: ou=support,ou=people,@BASE@
objectClass: organizationalUnit
ou: support

dn: ou=groups,@BASE@
objectClass: organizationalUnit
ou: groups

dn: ou=service,@BASE@
objectClass: organizationalUnit
ou: service
description: Accounts for programs, not people

dn: uid=ada,ou=engineering,ou=people,@BASE@
objectClass: inetOrgPerson
uid: ada
cn: Ada Lovelace
givenName: Ada
sn: Lovelace
mail: ada@hyperstack.test
title: Principal Engineer
telephoneNumber: +60 3 1000 0001
userPassword: @DEMO_PASSWORD@

