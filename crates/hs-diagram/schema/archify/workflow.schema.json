{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperstack.local/schema/archify/workflow.schema.json",
  "$comment": "Adapted from Archify v3.2.0 (MIT), commit 208acba8d412335185b2056fedf54b3405df43fb. Reduced to lanes, nodes, edges and groups; HTML/agent-only fields were removed. See THIRD_PARTY_NOTICES.md. The renderer is not copied.",
  "title": "HyperStack workflow diagram IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "lanes", "nodes", "edges"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "diagram_type": { "const": "workflow" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "variant": { "enum": ["normal", "exception"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lane", "col", "type", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "lane": { "$ref": "common.schema.json#/$defs/id" },
          "col": { "type": "integer", "minimum": 0, "maximum": 5 },
          "type": { "$ref": "common.schema.json#/$defs/componentType" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sublabel": { "type": "string", "maxLength": 200 },
          "tag": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "maxLength": 200 },
          "variant": { "$ref": "common.schema.json#/$defs/variant" },
          "role": {
            "enum": ["main", "branch", "async", "return", "error"]
          },
          "fromSide": { "$ref": "common.schema.json#/$defs/side" },
          "toSide": { "$ref": "common.schema.json#/$defs/side" },
          "route": {
            "enum": [
              "auto",
              "straight",
              "drop",
              "outside-right",
              "return-left",
              "bottom-channel",
              "up-channel"
            ]
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "lane", "fromCol", "toCol"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "lane": { "$ref": "common.schema.json#/$defs/id" },
          "fromCol": { "type": "integer", "minimum": 0, "maximum": 5 },
          "toCol": { "type": "integer", "minimum": 0, "maximum": 5 },
          "variant": { "$ref": "common.schema.json#/$defs/variant" }
        }
      }
    }
  }
}
